def notifyDiscord(message) {
    sh """
    curl -H "Content-Type: application/json" \
         -X POST \
         -d '{"content": "${message}"}' \
         $DISCORD_WEBHOOK
    """
}


pipeline {
    agent any

    environment {
        DISCORD_WEBHOOK = credentials('DISCORD_WEBHOOK')
    }

    stages {

        stage('Checkout Code') {
            steps {
                script { notifyDiscord(":arrow_down: Checking out Book & Ride code...") }
                git branch: 'dev', url: 'https://github.com/rdrio02/BookAndRide.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                script { notifyDiscord(":package: Installing dependencies...") }
                sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install --upgrade pip
                pip install build
                pip install ".[dev]"
                '''
            }
        }

        stage('Run Tests') {
            steps {
                script { notifyDiscord(":test_tube: Running tests...") }
                sh '''
                . venv/bin/activate
                pytest -q
                '''
                script { notifyDiscord(":white_check_mark: Tests passed!") }
            }
        }

        stage('Build Package') {
            steps {
                script { notifyDiscord(":gear: Building Python package...") }
                sh '''
                . venv/bin/activate
                python -m build
                '''
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                script { notifyDiscord(":whale: Starting Docker Compose deployment...") }
                sh '''
                sudo docker compose build
                sudo docker compose down
                sudo docker compose up -d
                '''
                script { notifyDiscord(":rocket: Docker deployment completed!") }
            }
        }
    }

    post {
        success {
            script { notifyDiscord(":tada: CI/CD pipeline finished successfully!") }
        }
        failure {
            script { notifyDiscord(":x: CI/CD pipeline FAILED! Check Jenkins logs.") }
        }
    }
}
