def notifyDiscord(message) {
    withCredentials([string(credentialsId: 'DISCORD_WEBHOOK', variable: 'WEBHOOK')]) {
        sh(script: """
            curl -H "Content-Type: application/json" \
                 -X POST \
                 -d '{\"content\": \"${message}\"}' \
                 "$WEBHOOK"
        """)
    }
}

pipeline {
    agent any

    environment {
        DISCORD_WEBHOOK = credentials('DISCORD_WEBHOOK')
    }

    stages {
        
        stage('Check for new version') {
            steps {
                script {

                    def remoteHash = sh(
                        script: "git ls-remote https://github.com/rdrio02/BookAndRide.git refs/heads/dev | cut -f1",
                        returnStdout: true
                    ).trim()

                    def previousHashFile = '.last_commit'
                    def previousHash = fileExists(previousHashFile) ? readFile(previousHashFile).trim() : ''

                    if (remoteHash == previousHash) {
                        currentBuild.result = 'NOT_BUILT'
                        error("No new version")   // stop pipeline
                    } else {
                        writeFile file: previousHashFile, text: remoteHash
                    }
                }
            }
        }


        stage('Checkout Code') {
            steps {
                script { notifyDiscord(":arrow_down: Checking out Book & Ride code...") }
                git branch: 'dev', url: 'https://github.com/rdrio02/BookAndRide.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                script { notifyDiscord(":package: Installing dependencies...") }
                sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install --upgrade pip
                pip install build
                pip install ".[dev]"
                '''
            }
        }

        stage('Run Tests') {
            steps {
                script { notifyDiscord(":test_tube: Running tests...") }
                sh '''
                . venv/bin/activate
                pytest -q
                '''
                script { notifyDiscord(":white_check_mark: Tests passed!") }
            }
        }

        stage('Build Package') {
            steps {
                script { notifyDiscord(":gear: Building Python package...") }
                sh '''
                . venv/bin/activate
                python -m build
                '''
            }
        }

        stage('Deploy with Ansible') {
            steps {
                script { notifyDiscord(":whale: Deploying with Ansible...") }
                sh '''
                ansible-playbook ansible/playbook.yml
                '''
                script { notifyDiscord(":rocket: Ansible deployment completed!") }
            }
        }
    }

    post {
        success {
            script { notifyDiscord(":tada: CI/CD pipeline finished successfully!") }
        }
        failure {
            script { notifyDiscord(":x: CI/CD pipeline FAILED! Check Jenkins logs.") }
        }
    }
}
